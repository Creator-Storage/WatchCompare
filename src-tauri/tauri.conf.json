{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WatchCompare",
  "version": "0.1.0",
  "identifier": "network.creative.watchcompare",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WatchCompare — Creative Network",
        "width": 1280,
        "height": 800,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
